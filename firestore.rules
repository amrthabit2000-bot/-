rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection (allows leaderboard read for authenticated players)
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && incoming().uid == existing().uid;

      // Daily Claims subcollection
      match /claims/{claimId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == request.auth.uid;
      }

      // Matches subcollection (stores up to 20 matches per player)
      match /matches/{matchId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }
  }
}
