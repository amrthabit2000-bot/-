{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with daily rewards progress and stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID matching auth UID" },
        "name": { "type": "string", "description": "Display name of player", "maxLength": 50 },
        "rating": { "type": "number", "description": "Player rating points" },
        "coins": { "type": "number", "description": "Virtual coins balance" },
        "lastActiveDate": { "type": "string", "description": "YYYY-MM-DD of last activity" },
        "lastMatchPlayedDate": { "type": "string", "description": "YYYY-MM-DD of last match played" },
        "dailyStreak": { "type": "number", "description": "Consecutive days played streak" },
        "lastClaimedDate": { "type": "string", "description": "YYYY-MM-DD of last claimed reward" },
        "claimedDay": { "type": "number", "description": "Day in 7-day cycle (1-7)" },
        "unlockedThemes": { "type": "string", "description": "Comma separated unlocked theme keys" },
        "unlockedDiceStyles": { "type": "string", "description": "Comma separated unlocked dice styles" },
        "selectedTheme": { "type": "string", "description": "Active board theme" },
        "selectedDiceStyle": { "type": "string", "description": "Active dice style" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["uid", "name"]
    },
    "DailyClaim": {
      "title": "DailyClaim",
      "description": "Record of a daily reward claim",
      "type": "object",
      "properties": {
        "claimId": { "type": "string", "description": "Unique claim identifier" },
        "userId": { "type": "string", "description": "User who claimed the reward" },
        "date": { "type": "string", "description": "Date of claim YYYY-MM-DD" },
        "dayNumber": { "type": "number", "description": "Day number in cycle (1-7)" },
        "rewardType": { "type": "string", "description": "points or theme" },
        "rewardValue": { "type": "string", "description": "Reward description or points value" },
        "claimedAt": { "type": "string", "description": "Timestamp when claimed" }
      },
      "required": ["claimId", "userId", "date", "dayNumber", "rewardType"]
    },
    "SavedMatch": {
      "title": "SavedMatch",
      "description": "Saved match record for the player (retains the latest 20 matches per player)",
      "type": "object",
      "properties": {
        "matchId": { "type": "string", "description": "Unique match identifier" },
        "userId": { "type": "string", "description": "User ID of the player" },
        "opponentName": { "type": "string", "description": "Opponent display name" },
        "winner": { "type": "string", "description": "player or opponent" },
        "playerPoints": { "type": "number", "description": "Points scored by player" },
        "opponentPoints": { "type": "number", "description": "Points scored by opponent" },
        "ratingAfter": { "type": "number", "description": "Player rating after match" },
        "coinsWon": { "type": "number", "description": "Coins gained or lost in challenge match" },
        "date": { "type": "string", "description": "Arabic formatted match date" },
        "playedAt": { "type": "string", "description": "ISO timestamp of match" }
      },
      "required": ["matchId", "userId", "winner", "playerPoints", "opponentPoints"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document storing player state and daily reward progress"
    },
    "/users/{userId}/claims/{claimId}": {
      "schema": { "$ref": "#/entities/DailyClaim" },
      "description": "Audit subcollection of daily rewards claimed by the user"
    },
    "/users/{userId}/matches/{matchId}": {
      "schema": { "$ref": "#/entities/SavedMatch" },
      "description": "Saved history of up to 20 recent matches played by the user"
    }
  }
}
